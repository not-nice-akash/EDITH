# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:5500

# Security (generate strong random strings for production)
JWT_SECRET=replace_with_a_long_random_jwt_secret_key
# 32-byte hex key (64 hex characters) for AES-256-GCM token encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Telegram Bot API (@edith_briefing_bot) & Voice Notes
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
TELEGRAM_TTS_VOICE=en-IN-NeerjaNeural

# Google Gemini API Key (optional: falls back to rule-based summary if empty)
GEMINI_API_KEY=

# Optional: Twilio SMS OTP & Programmable Voice (leave blank to use free dev OTP & Telegram)
OTP_DEV_MODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=http://localhost:4000
